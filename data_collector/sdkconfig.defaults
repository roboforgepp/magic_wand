CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3 Flash configuration (Seeed Studio XIAO ESP32S3 has 8MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# FreeRTOS 1kHz tick rate for 1ms timing precision
CONFIG_FREERTOS_HZ=1000

# Console over USB Serial/JTAG (Native USB on XIAO ESP32S3)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# CPU Frequency (Max 240MHz for high performance)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Flash Frequency (80MHz high speed)
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# External PSRAM / SPIRAM Support (8MB Octal OPI PSRAM on XIAO ESP32S3)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
